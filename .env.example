# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_video_platform

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# AI Providers
OPENAI_API_KEY=

# Voice Providers
ELEVENLABS_API_KEY=

# Video Providers
RUNWAY_API_KEY=
# Higgsfield (video): key from Higgsfield Cloud; model slug from your account's catalog
HIGGSFIELD_API_KEY=
HIGGSFIELD_VIDEO_MODEL=

# Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ai-video-platform
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Async renders: set true to dispatch renders to the Celery worker (requires a running worker)
RENDER_ASYNC=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001