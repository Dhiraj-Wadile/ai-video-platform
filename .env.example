# =============================================================================
# AI Video Platform - environment configuration
# Copy this file to `.env` and fill in the values you need.
#
# The app runs with ZERO keys in a limited "free/demo" mode:
#   - Images  -> Pollinations.ai (free, no key)
#   - Video   -> Pollinations.ai (free, no key) as fallback
#   - Voice   -> mock (silent placeholder)
#   - LLM     -> REQUIRES a key. Scripts/storyboards/trends do NOT work without one.
# See docs/CREDENTIALS.md for where to get every key and the recommended order.
# =============================================================================

# --- Core (required to run anywhere real) ------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Database. Dev default is SQLite; for production use a hosted Postgres URL
# (Neon/Supabase/Railway). The app converts "postgresql://" to the async driver.
# Dev:        sqlite+aiosqlite:///./app.db
# Production: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Redis - required only when RENDER_ASYNC=true (background renders via Celery).
REDIS_URL=redis://localhost:6379

# --- AI providers (these turn on real generation) ----------------------------
# LLM (required for scripts/storyboard/quality/trends). OpenAI-compatible:
# Claude / Perplexity / Groq also work but need a code change (base_url + model).
OPENAI_API_KEY=

# Voice narration. Without a key the pipeline uses a silent mock voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Video generation. Higgsfield is preferred, then Runway, then free Pollinations.
# Get the model slug from your Higgsfield account catalog (e.g. higgsfield-ai/veo3).
HIGGSFIELD_API_KEY=
HIGGSFIELD_VIDEO_MODEL=
RUNWAY_API_KEY=

# --- Storage -----------------------------------------------------------------
# local  = files on disk (default, fine for dev)
# s3     = MinIO / AWS S3 / Cloudflare R2
STORAGE_BACKEND=local
STORAGE_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ai-video-platform
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Behaviour ---------------------------------------------------------------
# false = render inside the API request (simple). true = dispatch to Celery worker.
RENDER_ASYNC=false
# Minimum QualityAgent score (0-100) before a project is allowed to publish.
QA_THRESHOLD=70

# --- Web ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Social publishing (optional; without these, publishing runs in simulated mode) ---
# YouTube Shorts (OAuth access token with youtube.upload scope)
YOUTUBE_ACCESS_TOKEN=
# TikTok Content Posting API (OAuth access token with video.publish scope)
TIKTOK_ACCESS_TOKEN=
# Instagram Reels via Meta Graph API (long-lived token + IG Business account id)
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Billing (optional; enables Stripe checkout on the pricing page) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# =============================================================================
# OPTIONAL - not wired up yet. Uncomment only after the matching integration
# is built (see docs/CREDENTIALS.md "What still needs code").
# =============================================================================

# Images / design: Google Gemini image ("Nanobanana") + Canva
# GEMINI_API_KEY=
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=

# Music (Suno-style) and captions (Submagic alternative)
# SUNO_API_KEY=
# DEEPGRAM_API_KEY=

# Research (Perplexity) and 3D (Luma)
# PERPLEXITY_API_KEY=
# LUMA_API_KEY=

# LTX-2 video (usually via an aggregator such as fal.ai / Replicate)
# FAL_API_KEY=
# REPLICATE_API_TOKEN=

# Transactional email
# RESEND_API_KEY=

